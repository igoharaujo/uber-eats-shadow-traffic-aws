    {
      "bucket": "owshq-shadow-traffic",
      "bucketConfigs": {
        "keyPrefix": "cdc/mssql/users/",
        "format": "jsonl"
      },
      "data": {
        "sequenceNum": {
          "_gen": "sequentialInteger",
          "startingFrom": 1
        },
        "operation": {
          "_gen": "weightedOneOf",
          "choices": [
            {
              "weight": 6,
              "value": "INSERT"
            },
            {
              "weight": 3,
              "value": "UPDATE"
            },
            {
              "weight": 1,
              "value": "DELETE"
            }
          ]
        },
